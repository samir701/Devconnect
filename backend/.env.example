# ==============================================================================
# Devconnect / ZettaDev - Backend Environment Variables Template
# ==============================================================================
# TiDB Cloud Serverless (MySQL 8.0)
DATABASE_URL="mysql://<user>:<password>@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/devconnect?ssl={\"rejectUnauthorized\":true}"
TIDB_DATABASE_URL="mysql://<user>:<password>@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/devconnect?ssl={\"rejectUnauthorized\":true}"
TIDB_HOST="gateway01.us-east-1.prod.aws.tidbcloud.com"
TIDB_PORT="4000"
TIDB_USER="<user>"
TIDB_PASSWORD="<password>"
TIDB_DATABASE="devconnect"

# Backblaze B2 Object Storage (S3-Compatible)
B2_APPLICATION_KEY_ID="<your-b2-key-id>"
B2_KEY_ID="<your-b2-key-id>"
AWS_ACCESS_KEY_ID="<your-b2-key-id>"

B2_APPLICATION_KEY="<your-b2-application-key>"
B2_APP_KEY="<your-b2-application-key>"
AWS_SECRET_ACCESS_KEY="<your-b2-application-key>"

B2_BUCKET_NAME="zettadev-storage"
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"

# Phase 6: Notifications & Transactional Email (Resend)
RESEND_API_KEY="re_<your-resend-api-key>"
RESEND_FROM_DOMAIN="zettadev.app"
MAIL_FROM_DOMAIN="zettadev.app"

# Socket Gateway
SOCKET_PORT="3001"
SOCKET_URL="http://localhost:3001"
INTERNAL_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
