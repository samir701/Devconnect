# ==============================================================================
# Devconnect (ZettaDev) - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) and replace the placeholders
# with your actual cloud credentials and configuration values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (TiDB Cloud Serverless / MySQL 8.0)
# ------------------------------------------------------------------------------
# Primary connection string for TiDB Cloud Serverless / Prisma ORM
# Obtain from TiDB Cloud Console -> Connect -> Connection String
DATABASE_URL="mysql://<user>:<password>@<gateway-host>.tidbcloud.com:4000/devconnect?ssl={\"rejectUnauthorized\":true}"

# Alternative TiDB Connection URL alias
TIDB_DATABASE_URL="mysql://<user>:<password>@<gateway-host>.tidbcloud.com:4000/devconnect?ssl={\"rejectUnauthorized\":true}"

# Optional Individual TiDB Connection Parameters
TIDB_HOST="<gateway-host>.tidbcloud.com"
TIDB_PORT="4000"
TIDB_USER="<user>"
TIDB_PASSWORD="<password>"
TIDB_DATABASE="devconnect"

# ------------------------------------------------------------------------------
# 2. OBJECT STORAGE CONFIGURATION (Backblaze B2 S3-Compatible)
# ------------------------------------------------------------------------------
# Generate an Application Key in Backblaze B2 (Read & Write permissions)
# B2 Application Key ID (25 hex characters, e.g. 005a1b2c3d4e5f60000000001)
B2_APPLICATION_KEY_ID="<your-b2-application-key-id>"
B2_KEY_ID="<your-b2-application-key-id>"
AWS_ACCESS_KEY_ID="<your-b2-application-key-id>"

# B2 Application Key Secret (31-42 characters, e.g. K005abc123...)
B2_APPLICATION_KEY="<your-b2-application-key-secret>"
B2_APP_KEY="<your-b2-application-key-secret>"
AWS_SECRET_ACCESS_KEY="<your-b2-application-key-secret>"

# Backblaze B2 Bucket Name
B2_BUCKET_NAME="zettadev-storage"

# S3-compatible B2 Endpoint URL
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"

# S3 Region
B2_REGION="us-east-005"

# ------------------------------------------------------------------------------
# 3. NOTIFICATIONS & TRANSACTIONAL EMAIL (Resend API)
# ------------------------------------------------------------------------------
# Resend API Key for transactional email notifications (e.g., re_123456789...)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="re_<your-resend-api-key>"

# Sender domain verified in Resend (e.g. zettadev.app or resend.dev for test sandbox)
RESEND_FROM_DOMAIN="zettadev.app"
MAIL_FROM_DOMAIN="zettadev.app"

# ------------------------------------------------------------------------------
# 4. REAL-TIME SOCKET GATEWAY (Socket.IO)
# ------------------------------------------------------------------------------
# Public WebSocket Gateway URL for browser / client
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Internal Server-to-Socket Gateway URL for serverless event dispatch
INTERNAL_SOCKET_URL="http://localhost:3001"

# Standalone Socket.IO port (scripts/socket-server.mjs)
SOCKET_PORT="3001"

# Realtime test suite socket connection URL
SOCKET_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 5. APPLICATION & GENERAL ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime Environment (development | production | test)
NODE_ENV="development"

# Web Server Port
PORT="3000"

# Application Base URLs
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secrets for JWT and session management
AUTH_SECRET="your_secret_auth_key_min_32_characters_here"
JWT_SECRET="your_secret_jwt_key_min_32_characters_here"
